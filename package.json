{
  "name": "lattice",
  "version": "0.0.0",
  "private": true,
  "description": "LATTICE — governance substrate",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "lattice": "./dist/cli/main.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --incremental --tsBuildInfoFile .lattice/tsc/typecheck.tsbuildinfo",
    "test": "vitest run",
    "lint": "eslint --cache --cache-location .lattice/eslint/ --cache-strategy content",
    "lint:ids": "node discussion/tools/lint-ids.mjs",
    "lint:eol": "node scripts/check-eol.mjs",
    "plan:check": "node plan/tools/plan-check.mjs",
    "build": "tsc -p tsconfig.build.json",
    "verify": "node scripts/verify.mjs",
    "prove": "node scripts/prove.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
