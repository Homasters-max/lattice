{
  "abstract": false,
  "kind": "event",
  "schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "format": "ref",
        "ref": {
          "to": "std/port@1",
          "pin": "pinned",
          "label": "uses"
        },
        "description": "the operation, port@n#operations/<op> (TY-09, RT-23)"
      },
      "request": {
        "type": "string",
        "minLength": 1,
        "description": "the hash of the request (RT-23)"
      },
      "occurrence": {
        "type": "integer",
        "minimum": 1,
        "description": "which occurrence of the same request it answers (RT-23)"
      },
      "answer": {
        "type": "object",
        "description": "the answer of the port (RT-23); any value, which the subset cannot say: closed until the kernel takes the keyword of S0-53 (G-38)"
      },
      "error": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string",
            "minLength": 1,
            "description": "the adapter"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "the error code"
          },
          "status": {
            "type": "integer",
            "description": "the status, where there is one"
          },
          "retryable": {
            "type": "boolean",
            "description": "a rate limit is retryable (RT-23)"
          }
        },
        "required": [
          "adapter",
          "code",
          "retryable"
        ],
        "description": "an adapter error, never a body or headers of a vendor (RT-23)"
      },
      "ms": {
        "type": "integer",
        "minimum": 0,
        "description": "its time in milliseconds (RT-23)"
      },
      "tokens": {
        "type": "integer",
        "minimum": 0,
        "description": "its tokens where known (RT-23)"
      },
      "billing": {
        "enum": [
          "api",
          "subscription",
          "local"
        ],
        "description": "how the answer is paid for (RT-23)"
      },
      "usd": {
        "type": "string",
        "format": "decimal",
        "description": "the cost in USD, only for billing api (RT-23)"
      },
      "mode": {
        "enum": [
          "service",
          "recorded",
          "fixture"
        ],
        "description": "the mode of the port (RT-22, RT-23)"
      },
      "model": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "the model id the adapter reports"
          },
          "check": {
            "enum": [
              "verified",
              "reported",
              "none"
            ],
            "description": "whether it was checked against the pinned one (RT-23, DP-10)"
          }
        },
        "required": [
          "id",
          "check"
        ],
        "description": "the model that answered (RT-23)"
      },
      "memo": {
        "type": "string",
        "format": "ref",
        "ref": {
          "to": "std/run@1",
          "pin": "any",
          "label": "derived-from"
        },
        "description": "the run a memo answer came from (RT-24)"
      }
    },
    "required": [
      "operation",
      "request",
      "occurrence",
      "ms",
      "billing",
      "mode"
    ]
  }
}
